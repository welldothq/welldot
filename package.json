{
  "name": "welldot",
  "private": true,
  "type": "module",
  "scripts": {
    "profiler": "pnpm --filter profiler",
    "documentation": "pnpm --filter docs",
    "core": "pnpm --filter @welldot/core",
    "utils": "pnpm --filter @welldot/utils",
    "render": "pnpm --filter @welldot/render",
    "pdf": "pnpm --filter @welldot/pdf",
    "vue": "pnpm --filter @welldot/vue",
    "lint-config": "pnpm --filter @welldot/lint",
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,vue,md,json}\"",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release:tag": "changeset tag",
    "test:scripts": "node --test \"scripts/*.test.mjs\""
  },
  "packageManager": "pnpm@10.22.0",
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^8.57.1",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@welldot/lint": "workspace:*",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-vue": "^10.8.0",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "turbo": "latest",
    "typescript-eslint": "^8.59.0"
  }
}
