{
  "name": "@welldot/render",
  "version": "0.4.2",
  "description": "D3-based SVG visualization library for rendering geological well profiles",
  "license": "Apache-2.0",
  "keywords": [
    "d3",
    "svg",
    "geology",
    "well",
    "visualization",
    "lithology",
    "well-profiler"
  ],
  "author": {
    "name": "Rafael Neto",
    "email": "rafaelneto.g@gmail.com"
  },
  "homepage": "https://github.com/welldothq/welldot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/welldothq/welldot.git",
    "directory": "packages/render"
  },
  "bugs": {
    "url": "https://github.com/welldothq/welldot/issues"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./textures": {
      "types": "./dist/textures.d.ts",
      "import": "./dist/textures.js",
      "require": "./dist/textures.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "thumbnails:examples": "node scripts/generate-example-thumbnails.mjs",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "dependencies": {
    "@welldot/core": "workspace:*",
    "@welldot/utils": "workspace:*",
    "d3": "^7.0.0",
    "d3-tip": "^0.9.1",
    "defu": "^6.1.4",
    "sanitize-html": "^2.17.7",
    "textures": "^1.2.3"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/d3-tip": "^3.5.8",
    "@types/sanitize-html": "^2.16.1",
    "@welldot/lint": "workspace:*",
    "jsdom": "^23.2.0",
    "tsup": "^8.3.0",
    "typescript": "^5.3.3",
    "vite": "^8.0.9",
    "vitest": "^4.1.5"
  }
}
