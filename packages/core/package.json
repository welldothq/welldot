{
  "name": "@welldot/core",
  "version": "0.6.0",
  "type": "module",
  "description": "TypeScript types, Zod validators, and serialization utilities for the .well open format — a JSON standard for water well data.",
  "keywords": [
    "well",
    "water-well",
    "hydrogeology",
    "geoscience",
    "borehole",
    "lithology",
    "schema",
    "zod",
    "typescript",
    "open-data"
  ],
  "author": {
    "name": "Rafael Neto",
    "email": "rafaelneto.g@gmail.com"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/welldothq/welldot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/welldothq/welldot.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/welldothq/welldot/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./well.schema.json": "./dist/well.schema.json",
    "./examples/*": "./examples/*"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "examples"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "generate:schema": "tsx scripts/generate-schema.ts",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "dependencies": {
    "defu": "^6.1.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@welldot/lint": "workspace:*",
    "tsup": "^8.3.0",
    "tsx": "^4.22.0",
    "typescript": "^5.3.3",
    "vite": "^8.0.9",
    "vitest": "^4.1.5",
    "zod-to-json-schema": "^3.25.2"
  }
}
