{
  "plugin": ["typedoc-plugin-markdown"],
  "readme": "none",
  "entryFileName": "index",
  "outputFileStrategy": "members",
  "hidePageHeader": true,
  "hideBreadcrumbs": true,
  "excludePrivate": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "disableSources": true,
  "githubPages": false,
  "skipErrorChecking": true,
  "logLevel": "Warn"
}
