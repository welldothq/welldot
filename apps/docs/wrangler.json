{
  "name": "welldot-docs",
  "compatibility_date": "2025-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./.output/server/index.mjs",
  "assets": {
    "directory": "./.output/public",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash"
  },
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "env": {
    "preview": {
      "name": "preview-welldot-docs",
      "workers_dev": false,
      "preview_urls": false
    }
  }
}
